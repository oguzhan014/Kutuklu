# Database
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/zeytin_db?schema=public"

# Auth.js v5 (NextAuth)
# Üretimde mutlaka rastgele üretin:  openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Stripe
# Test anahtarları: https://dashboard.stripe.com/test/apikeys
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-posta (Resend) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Kütüklü Zeytinyağı <siparis@kutuklu.com>"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
