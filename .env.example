# Database
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/zeytin_db?schema=public"

# Auth.js v5 (NextAuth)
# Üretimde mutlaka rastgele üretin:  openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# PayTR — mağaza panelindeki "Bilgi" sayfasından alınır.
# Bildirim URL'i panelde şu olarak tanımlanmalı:
#   https://<alan-adiniz>/api/webhooks/paytr
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = test modu (gerçek para çekilmez), 0 = canlı tahsilat
PAYTR_TEST_MODE="1"

# E-posta (Resend) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Kütüklü Zeytinyağı <siparis@kutuklu.com>"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
